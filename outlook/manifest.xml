<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>d319b1c5-8e20-491c-be20-f44638e0c6d3</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Windoform CRM</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Windoform CRM"/>
  <Description DefaultValue="Kontaktinfos anzeigen und E-Mails automatisch ins CRM speichern"/>

  <IconUrl DefaultValue="https://windoform.vercel.app/assets/img/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://windoform.vercel.app/assets/img/icon-80.png"/>
  <SupportUrl DefaultValue="https://windoform.vercel.app"/>

  <AppDomains>
    <AppDomain>windoform.vercel.app</AppDomain>
    <AppDomain>firestore.googleapis.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://windoform.vercel.app/outlook/taskpane.html"/>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://windoform.vercel.app/outlook/taskpane.html?mode=read"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.4">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">

        <DesktopFormFactor>

          <!-- Hintergrund-Funktion für Auto-Save beim Senden -->
          <FunctionFile resid="FunctionFile.Url"/>

          <!-- Auto-Save: E-Mail beim Senden automatisch ins CRM speichern -->
          <ExtensionPoint xsi:type="Events">
            <Event Type="ItemSend" FunctionExecution="synchronous" FunctionName="onItemSend"/>
          </ExtensionPoint>

          <!-- Compose Modus: Seitenleiste beim Schreiben -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>WindoformCRMPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Read Modus: Seitenleiste beim Lesen (mit Pin-Funktion) -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>WindoformCRMPane</TaskpaneId>
                    <SupportsPinning>true</SupportsPinning>
                    <SourceLocation resid="Taskpane.UrlRead"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://windoform.vercel.app/assets/img/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://windoform.vercel.app/assets/img/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://windoform.vercel.app/assets/img/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url"     DefaultValue="https://windoform.vercel.app/outlook/taskpane.html"/>
        <bt:Url id="Taskpane.UrlRead" DefaultValue="https://windoform.vercel.app/outlook/taskpane.html?mode=read"/>
        <bt:Url id="FunctionFile.Url" DefaultValue="https://windoform.vercel.app/outlook/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel"           DefaultValue="Windoform CRM"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="CRM Kontakt"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Kontaktinfos aus dem CRM anzeigen und E-Mail speichern"/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
